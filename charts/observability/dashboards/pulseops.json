{
    "uid": "pulseops-slo",
    "title": "PulseOps - SLO Overview",
    "tags": ["pulseops", "sre", "slo"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "API Availability",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "100 * pulseops:sli:api_availability:ratio5m",
                    "legendFormat": "Availability",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 99
                            },
                            {
                                "color": "green",
                                "value": 99.5
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "values": false
                },
                "orientation": "auto",
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "auto"
            }
        },
